<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="tabMorfo" label="Morfo">
        
        <!-- Grupo de Transformación de Mayúsculas / Minúsculas -->
        <group id="grpCase" label="Formato de Mayúsculas y Minúsculas">
          <button id="btnUpper" 
                  label="MAYÚSCULAS" 
                  size="large" 
                  imageMso="CharacterBorder" 
                  screentip="Convertir a MAYÚSCULAS" 
                  supertip="Convierte todo el texto del rango o fila seleccionada a mayúsculas." 
                  onAction="CallbackMayusculas" />
          <button id="btnLower" 
                  label="minúsculas" 
                  size="large" 
                  image="minus" 
                  screentip="Convertir a minúsculas" 
                  supertip="Convierte todo el texto del rango o fila seleccionada a minúsculas." 
                  onAction="CallbackMinusculas" />
          <button id="btnProper" 
                  label="Nombre Propio" 
                  size="large" 
                  imageMso="FontCaseCapitalizeEachWord" 
                  screentip="Convertir a Nombre Propio" 
                  supertip="Pone en mayúscula la primera letra de cada palabra en la selección." 
                  onAction="CallbackNombrePropio" />
          <button id="btnSentence" 
                  label="Tipo Oración" 
                  size="large" 
                  imageMso="WordArtFormatDialog" 
                  screentip="Convertir a Tipo Oración" 
                  supertip="Convierte únicamente la primera letra de la oración o texto a mayúscula y el resto a minúsculas." 
                  onAction="CallbackTipoOracion" />
        </group>

        <!-- Grupo de Limpieza de Bases de Datos -->
        <group id="grpCleaning" label="Limpieza de Bases de Datos">
          <button id="btnSpaces" 
                  label="Quitar Espacios" 
                  size="large" 
                  imageMso="SpaceAfterParagraph" 
                  screentip="Eliminar Espacios Innecesarios" 
                  supertip="Elimina espacios iniciales y finales (Trim), dobles espacios y espacios web (ASCII 160)." 
                  onAction="CallbackLimpiarEspacios" />
          <button id="btnAccents" 
                  label="Quitar Acentos" 
                  size="large" 
                  imageMso="ReviewTranslate" 
                  screentip="Eliminar Acentos y Tildes" 
                  supertip="Reemplaza vocales con tildes (á, é, í, ó, ú, ü) por sus equivalentes sin acento." 
                  onAction="CallbackQuitarAcentos" />
          <button id="btnRare" 
                  label="Quitar todos" 
                  size="large" 
                  imageMso="StyleDelete" 
                  screentip="Eliminar Caracteres Raros de BD" 
                  supertip="Elimina códigos de control ASCII (0-31), saltos de línea indeseados y caracteres invisibles." 
                  onAction="CallbackQuitarRaros" />
          <button id="btnCleanAll" 
                  label="Limpieza Total" 
                  size="large" 
                  imageMso="AutoFormat" 
                  screentip="Limpieza Rápida Total (1-Clic)" 
                  supertip="Aplica de forma simultánea eliminación de caracteres raros, acentos y normalización de espacios." 
                  onAction="CallbackLimpiezaTotal" />
        </group>

        <!-- Grupo de Opciones Avanzadas -->
        <group id="grpAdvanced" label="Personalización">
          <button id="btnTextEditor" 
                  label="Editor de Selección" 
                  size="large" 
                  imageMso="TextBoxInsert" 
                  screentip="Editar y Transformar Texto Seleccionado" 
                  supertip="Permite seleccionar palabras, frases o párrafos dentro de una celda y transformarlos a mayúsculas, minúsculas, etc." 
                  onAction="CallbackEditorTexto" />
          <button id="btnAdvanced" 
                  label="Opciones Avanzadas" 
                  size="large" 
                  imageMso="CustomActionsGallery" 
                  screentip="Ventana de Opciones Avanzadas de Morfo" 
                  supertip="Abre la ventana flotante interactiva con vista previa en vivo y opciones a medida." 
                  onAction="CallbackFormularioAvanzado" />
        </group>

      </tab>
    </tabs>
  </ribbon>

  <!-- Menú Contextual al hacer Clic Derecho sobre celdas o filas -->
  <contextMenus>
    <contextMenu idMso="ContextMenuCell">
      <menu id="ctxMenuMorfo" label="Morfo: Limpieza y Texto" imageMso="AutoFormat" insertBeforeMso="Cut">
        <button id="ctxUpper" label="🔤 MAYÚSCULAS" imageMso="CharacterBorder" onAction="CallbackMayusculas" />
        <button id="ctxLower" label="🔡 minúsculas" image="minus" onAction="CallbackMinusculas" />
        <button id="ctxProper" label="🔠 Nombre Propio" imageMso="FontCaseCapitalizeEachWord" onAction="CallbackNombrePropio" />
        <button id="ctxSentence" label="📝 Tipo Oración" imageMso="WordArtFormatDialog" onAction="CallbackTipoOracion" />
        <menuSeparator id="ctxSep1" />
        <button id="ctxSpaces" label="✂️ Quitar Espacios" imageMso="SpaceAfterParagraph" onAction="CallbackLimpiarEspacios" />
        <button id="ctxAccents" label="✨ Quitar Acentos" imageMso="ReviewTranslate" onAction="CallbackQuitarAcentos" />
        <button id="ctxRare" label="🛡️ Quitar Caracteres Raros" imageMso="StyleDelete" onAction="CallbackQuitarRaros" />
        <menuSeparator id="ctxSep2" />
        <button id="ctxCleanAll" label="⚡ Limpieza Total 1-Clic" imageMso="AutoFormat" onAction="CallbackLimpiezaTotal" />
        <button id="ctxTextEditor" label="📝 Editar / Transformar Selección..." imageMso="TextBoxInsert" onAction="CallbackEditorTexto" />
        <button id="ctxAdv" label="⚙️ Opciones Avanzadas..." imageMso="CustomActionsGallery" onAction="CallbackFormularioAvanzado" />
      </menu>
    </contextMenu>
  </contextMenus>
</customUI>
